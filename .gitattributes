# Normalize all text files to LF in the repository, regardless of the
# checking-out platform's core.autocrlf setting. This prevents CRLF/LF
# noise from swamping diffs on Windows checkouts.
* text=auto eol=lf

*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files should never be normalized
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mv.db binary
